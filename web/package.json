{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "generate:openapi": "openapi-typescript http://localhost:8080/v3/api-docs -o ./src/api/schema.d.ts",
    "check:openapi": "node -e \"if (!require('fs').existsSync('./src/api/schema.d.ts')) { console.error('schema.d.ts missing'); process.exit(1); }\"",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.12",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-form": "^1.2.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "clsx": "^2.1.1",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "react-is": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.145.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
