{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:agent": "vite build --logLevel warn",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "check:agent": "biome check ./src --reporter=concise",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agent": "vitest run --reporter=minimal",
    "verify:agent": "npm run --silent typecheck && npm run --silent check:agent && npm run --silent test:agent && npm run --silent build:agent",
    "generate:openapi": "openapi-typescript http://localhost:8080/v3/api-docs --output ./src/api/schema.d.ts",
    "check:openapi": "openapi-typescript http://localhost:8080/v3/api-docs --output ./src/api/schema.d.ts --check",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@mantine/carousel": "^9.6.0",
    "@mantine/charts": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-form": "^1.2.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "clsx": "^2.1.1",
    "decimal.js-light": "^2.5.1",
    "embla-carousel-react": "^8.6.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "overrides": {
    "react-is": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.145.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
