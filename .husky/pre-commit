#!/usr/bin/env bash

set -u

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

# ── Capture originally staged files ──────────────────────────────────────────
#
# Only files staged BEFORE this hook starts may be automatically re-staged.
# This prevents unrelated unstaged changes from entering the commit.

mapfile -d '' -t STAGED_FILES < <(
  git diff --cached --name-only --diff-filter=ACMR -z
)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  echo 'No staged files.'
  exit 0
fi


# ── Protect partially staged files ───────────────────────────────────────────
#
# Example:
#
#   Foo.java
#     hunk A -> staged
#     hunk B -> unstaged
#
# Running `git add Foo.java` after formatting would also stage hunk B.
# Therefore auto-fix is unsafe for partially staged files.

PARTIALLY_STAGED=()

for file in "${STAGED_FILES[@]}"; do
  if ! git diff --quiet -- "$file"; then
    PARTIALLY_STAGED+=("$file")
  fi
done

if [ ${#PARTIALLY_STAGED[@]} -gt 0 ]; then
  echo ''
  echo 'FAILED: These files contain both staged and unstaged changes:'
  printf '  %s\n' "${PARTIALLY_STAGED[@]}"
  echo ''
  echo 'Pre-commit auto-fix cannot safely re-stage partially staged files.'
  exit 1
fi


# ── Classify staged files ────────────────────────────────────────────────────

JAVA_FILES=()
BIOME_FILES=()
TYPESCRIPT_FILES=()

for file in "${STAGED_FILES[@]}"; do
  case "$file" in

    # Java
    server/*.java)
      JAVA_FILES+=("$file")
      ;;

    # TypeScript / JavaScript:
    # - Biome
    # - TypeScript typecheck
    web/src/*.ts|web/src/*.tsx|web/src/*.js|web/src/*.jsx|web/src/*.mts|web/src/*.cts|web/src/*.mjs|web/src/*.cjs)
      BIOME_FILES+=("$file")
      TYPESCRIPT_FILES+=("$file")
      ;;

    # JSON files Biome may format/check.
    # Remove these if your biome config intentionally ignores them.
    web/src/*.json|web/src/*.jsonc)
      BIOME_FILES+=("$file")
      ;;

    # Everything else under web/src — CSS, SVG, images, etc.
    #
    # These are intentionally not sent to Biome unless explicitly supported
    # by the project's biome configuration.
    web/src/*)
      ;;
  esac
done


# ── Java: Spotless auto-fix ─────────────────────────────────────────────────

if [ ${#JAVA_FILES[@]} -gt 0 ]; then
  echo 'Running Spotless (spotless:apply)...'

  cd "$REPO_ROOT/server" || exit 1

  ./mvnw spotless:apply -q
  SPOTLESS_EXIT=$?

  if [ $SPOTLESS_EXIT -ne 0 ]; then
    echo ''
    echo 'FAILED: Spotless formatting failed.'
    exit 1
  fi

  cd "$REPO_ROOT" || exit 1

  # Only re-stage Java files that were already staged before the hook started.
  git add -- "${JAVA_FILES[@]}"

  echo 'OK: Java formatting done.'
else
  echo 'Skipping Spotless: no staged Java files.'
fi


# ── Frontend: Biome auto-fix ─────────────────────────────────────────────────

if [ ${#BIOME_FILES[@]} -gt 0 ]; then
  echo 'Running Biome auto-fix...'

  cd "$REPO_ROOT/web" || exit 1

  # Convert:
  #
  #   web/src/foo.ts
  #
  # into:
  #
  #   src/foo.ts

  BIOME_RELATIVE_FILES=()

  for file in "${BIOME_FILES[@]}"; do
    BIOME_RELATIVE_FILES+=("${file#web/}")
  done

  BIOME_EXIT=0

  npx biome check --write "${BIOME_RELATIVE_FILES[@]}" || BIOME_EXIT=$?

  cd "$REPO_ROOT" || exit 1

  # Preserve safe fixes Biome already made, but only for files that were
  # originally staged.
  git add -- "${BIOME_FILES[@]}"

  if [ $BIOME_EXIT -ne 0 ]; then
    echo ''
    echo 'FAILED: Biome found errors that could not be fixed automatically.'
    exit 1
  fi

  echo 'OK: Biome formatting/lint fixes applied.'
else
  echo 'Skipping Biome: no staged Biome-supported files.'
fi


# ── Frontend: TypeScript type check ──────────────────────────────────────────
#
# There is no reason to run the entire TypeScript compiler for commits that
# only modify CSS, SVGs, images, etc.
#
# Run it only when TypeScript / JavaScript source files are staged.

if [ ${#TYPESCRIPT_FILES[@]} -gt 0 ]; then
  echo 'Running TypeScript type check (tsc -b)...'

  cd "$REPO_ROOT/web" || exit 1

  npm run typecheck
  TSC_EXIT=$?

  if [ $TSC_EXIT -ne 0 ]; then
    echo ''
    echo 'FAILED: TypeScript type check failed.'
    exit 1
  fi

  echo 'OK: TypeScript type check passed.'
else
  echo 'Skipping TypeScript type check: no staged TypeScript/JavaScript files.'
fi


# ── Done ─────────────────────────────────────────────────────────────────────

cd "$REPO_ROOT" || exit 1

echo ''
echo 'OK: All pre-commit checks passed.'
exit 0
