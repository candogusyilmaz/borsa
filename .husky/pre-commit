REPO_ROOT=$(git rev-parse --show-toplevel)

# ── Java: Spotless ────────────────────────────────────────────────────────────
echo 'Running Spotless (spotless:apply)...'
cd "$REPO_ROOT/server" || exit 1
./mvnw spotless:apply -q
SPOTLESS_EXIT=$?

if [ $SPOTLESS_EXIT -ne 0 ]; then
  echo ''
  echo 'FAILED: Spotless formatting failed. Fix the errors above before committing.'
  exit 1
fi

# Stage any Java files that Spotless reformatted
git diff --name-only -- '*.java' | xargs -r git add
echo 'OK: Java formatting done.'

# ── Frontend: TypeScript type check ──────────────────────────────────────────
echo 'Running TypeScript type check (tsc -b)...'
cd "$REPO_ROOT/web" || exit 1
npm run typecheck
TSC_EXIT=$?

if [ $TSC_EXIT -ne 0 ]; then
  echo ''
  echo 'FAILED: TypeScript type check failed. Fix the errors above before committing.'
  exit 1
fi

# ── Frontend: Biome check ────────────────────────────────────────────────────
echo 'Running Biome check...'

# First do a dry-run to detect any unformatted/lint issues
npx biome check ./src
BIOME_CHECK_EXIT=$?

if [ $BIOME_CHECK_EXIT -ne 0 ]; then
  # Auto-fix what can be fixed
  npm run check:fix
  echo ''
  echo 'Biome found and fixed issues. Staging the fixed files...'

  git diff --name-only -- ./src | xargs -r git add

  echo 'Fixed files have been staged. Please review and commit again.'
  exit 1
fi

echo 'OK: All checks passed.'
